# --- News brief ---
GROQ_API_KEY=your_groq_key_here
TELEGRAM_BOT_TOKEN=your_new_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Build suggestions (the BUILD NEXT section) ---
# Gemini free tier generates the two daily suggestions.
GEMINI_API_KEY=your_gemini_key_here
# Same Supabase project the reactions webhook writes to.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
# Reads open issues from Prism-Productivity-Tool and glamshelf-twin. Optional
# for public repos, but without it you share the 60 req/hr anonymous limit.
GITHUB_TOKEN=your_github_pat_here

# Optional. Set to 0 to ship the news brief without the suggestions section.
SUGGESTIONS_ENABLED=1
# Optional. Comma-separated fallback order; the first model that answers wins.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-flash-latest
